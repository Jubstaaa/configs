{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":semanticCommits",
        ":semanticCommitTypeAll(chore)"
    ],
    "schedule": [
        "* 0-6 * * 1"
    ],
    "timezone": "Europe/Istanbul",
    "labels": [
        "dependencies"
    ],
    "platformAutomerge": true,
    "packageRules": [
        {
            "matchUpdateTypes": [
                "minor",
                "patch"
            ],
            "matchCurrentVersion": "!/^0/",
            "automerge": true,
            "groupName": "non-major dependencies"
        },
        {
            "matchUpdateTypes": [
                "patch"
            ],
            "matchCurrentVersion": "/^0/",
            "automerge": true,
            "groupName": "non-major dependencies"
        },
        {
            "matchManagers": [
                "github-actions"
            ],
            "groupName": "github actions",
            "automerge": false
        },
        {
            "matchManagers": [
                "dockerfile",
                "docker-compose"
            ],
            "groupName": "container images",
            "automerge": false
        },
        {
            "matchPackageNames": [
                "/^@tauri-apps//",
                "/^tauri/"
            ],
            "groupName": "tauri"
        }
    ],
    "lockFileMaintenance": {
        "enabled": true,
        "automerge": true
    },
    "vulnerabilityAlerts": {
        "labels": [
            "security"
        ],
        "schedule": [
            "at any time"
        ],
        "automerge": true
    },
    "dependencyDashboard": false
}
