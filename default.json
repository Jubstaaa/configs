{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended",
        ":semanticCommits",
        ":semanticCommitTypeAll(chore)"
    ],
    "schedule": ["* 0-6 * * 1"],
    "timezone": "Europe/Istanbul",
    "labels": ["dependencies"],
    "platformAutomerge": true,
    "packageRules": [
        {
            "matchUpdateTypes": ["minor", "patch"],
            "matchCurrentVersion": "!/^0/",
            "automerge": true,
            "groupName": "non-major dependencies"
        },
        {
            "matchUpdateTypes": ["patch"],
            "matchCurrentVersion": "/^0/",
            "automerge": true,
            "groupName": "non-major dependencies"
        },
        {
            "matchManagers": ["github-actions"],
            "groupName": "github actions",
            "automerge": false
        },
        {
            "matchManagers": ["dockerfile", "docker-compose"],
            "matchUpdateTypes": ["patch", "digest"],
            "groupName": "container images",
            "automerge": true
        },
        {
            "matchManagers": ["dockerfile", "docker-compose"],
            "matchUpdateTypes": ["major", "minor"],
            "groupName": "container images",
            "automerge": false
        },
        {
            "matchPackageNames": [
                "eslint",
                "@eslint/**",
                "typescript-eslint",
                "@typescript-eslint/**",
                "eslint-plugin-*",
                "eslint-config-prettier"
            ],
            "groupName": "eslint"
        },
        {
            "matchPackageNames": ["vite", "@vitejs/**"],
            "groupName": "vite"
        },
        {
            "matchPackageNames": ["typescript", "@typescript/typescript6"],
            "matchUpdateTypes": ["major"],
            "enabled": false
        },
        {
            "matchPackageNames": ["payload", "@payloadcms/**"],
            "groupName": "payload",
            "automerge": false
        },
        {
            "matchPackageNames": ["next", "@next/**", "eslint-config-next"],
            "groupName": "next",
            "automerge": false
        },
        {
            "matchPackageNames": [
                "react",
                "react-dom",
                "@types/react",
                "@types/react-dom"
            ],
            "groupName": "react",
            "automerge": false
        },
        {
            "matchPackageNames": ["tailwindcss", "@tailwindcss/**"],
            "groupName": "tailwind",
            "automerge": false
        },
        {
            "matchPackageNames": ["@fortawesome/**"],
            "groupName": "fortawesome"
        },
        {
            "matchPackageNames": ["/^@tauri-apps//", "/^tauri/"],
            "groupName": "tauri"
        }
    ],
    "lockFileMaintenance": {
        "enabled": true,
        "automerge": true
    },
    "vulnerabilityAlerts": {
        "labels": ["security"],
        "schedule": ["at any time"],
        "automerge": true
    },
    "dependencyDashboard": false
}
