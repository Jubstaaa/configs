{
    "name": "@jubstaa/config",
    "version": "1.4.0",
    "description": "Shared ESLint, TypeScript, Prettier and Renovate configuration",
    "license": "MIT",
    "author": "\u0130lker Balc\u0131lar",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Jubstaaa/configs.git"
    },
    "type": "module",
    "exports": {
        "./eslint/base": {
            "types": "./dist/eslint/base.d.ts",
            "default": "./dist/eslint/base.js"
        },
        "./eslint/library": {
            "types": "./dist/eslint/library.d.ts",
            "default": "./dist/eslint/library.js"
        },
        "./eslint/next": {
            "types": "./dist/eslint/next.d.ts",
            "default": "./dist/eslint/next.js"
        },
        "./eslint/node": {
            "types": "./dist/eslint/node.d.ts",
            "default": "./dist/eslint/node.js"
        },
        "./eslint/react": {
            "types": "./dist/eslint/react.d.ts",
            "default": "./dist/eslint/react.js"
        },
        "./prettier": {
            "types": "./dist/prettier/index.d.ts",
            "default": "./dist/prettier/index.js"
        },
        "./tsconfig/base": "./typescript/base.json",
        "./tsconfig/library": "./typescript/library.json",
        "./tsconfig/next": "./typescript/next.json",
        "./tsconfig/node": "./typescript/node.json"
    },
    "files": [
        "default.json",
        "dist",
        "typescript"
    ],
    "peerDependencies": {
        "eslint": "^9.0.0 || ^10.0.0",
        "eslint-config-next": ">=15",
        "eslint-plugin-react-hooks": "^5.0.0 || ^6.0.0 || ^7.0.0",
        "eslint-plugin-react-refresh": "^0.4.0 || ^0.5.0",
        "prettier": "^3.0.0",
        "typescript": "^5.0.0 || ^6.0.0"
    },
    "dependencies": {
        "eslint-config-prettier": "^10.1.9",
        "eslint-plugin-no-comments": "^1.2.1",
        "eslint-plugin-perfectionist": "^5.14.0",
        "jiti": "^2.7.0",
        "typescript-eslint": "^8.74.0"
    },
    "peerDependenciesMeta": {
        "eslint-config-next": {
            "optional": true
        },
        "eslint-plugin-react-hooks": {
            "optional": true
        },
        "eslint-plugin-react-refresh": {
            "optional": true
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "keywords": [
        "eslint-config",
        "prettier-config",
        "tsconfig",
        "renovate-config"
    ],
    "bugs": {
        "url": "https://github.com/Jubstaaa/configs/issues"
    },
    "homepage": "https://github.com/Jubstaaa/configs#readme",
    "devDependencies": {
        "@types/node": "^26.6.11",
        "eslint": "^10.15.0",
        "eslint-config-next": "^16.4.6",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.8",
        "next": "16.4.6",
        "prettier": "^3.10.1",
        "typescript": "^5.9.3"
    },
    "bin": {
        "jubstaa-doctor": "./dist/bin/doctor.js"
    },
    "packageManager": "bun@1.4.4",
    "scripts": {
        "audit": "bun audit --audit-level=high",
        "build": "tsc",
        "doctor": "node dist/bin/doctor.js",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "lint": "eslint .",
        "pack:check": "node scripts/pack-check.mjs",
        "prepack": "tsc",
        "prepare": "tsc",
        "presets:check": "node scripts/presets-check.mjs",
        "typecheck": "tsc --noEmit"
    }
}
